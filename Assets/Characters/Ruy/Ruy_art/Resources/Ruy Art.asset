  voice:
    dialogue:
    - line: You know, they call me a genie. It's cause I grant death wishes.
      clip: {fileID: 8300000, guid: 7f7cb80cfadbdcc46ad7080b86f2d65a, type: 3}
    - line: That was a Ruy-ly good punch.
      clip: {fileID: 8300000, guid: 0baf917fd8f02744bb35a5dc5af2b27f, type: 3}
    - line: It seems I have been thoroughly pun-nished.
      clip: {fileID: 8300000, guid: aed263ddba7172b47abd67bfe278beed, type: 3}
    - line: "Hey! That\u2019s a Ruy-crime!"
      clip: {fileID: 8300000, guid: f500f6479422e794aab331945659cadf, type: 3}
    - line: You're being such a Kill-Ruy.
      clip: {fileID: 8300000, guid: 89f00a3601ee41242af9f6b787c409a3, type: 3}
    - line: Sure-you-can beat me?
      clip: {fileID: 8300000, guid: 26a1267ad0519fc479c3d98706bec5ed, type: 3}
    - line: Man, I'm bored, can you at least try to fight back?
      clip: {fileID: 8300000, guid: f174ee98f89e824428e61a0ffc16aea7, type: 3}
    - line: Get dest-Ruy-ed!
      clip: {fileID: 8300000, guid: aedaff597ed2c154ebec06a91b9a78c6, type: 3}
